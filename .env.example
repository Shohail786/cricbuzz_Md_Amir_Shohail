# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# --- Database (SQLAlchemy URL) ---
# SQLite (default, no server needed):
# DATABASE_URL=sqlite:///data/cricbuzz.db
# MySQL:      mysql+pymysql://user:password@localhost:3306/cricbuzz
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/cricbuzz

# --- Cricbuzz API (RapidAPI style) ---
RAPIDAPI_KEY=your_api_key_here
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com
API_TIMEOUT=10
API_MAX_RETRIES=3
CACHE_TTL_SECONDS=60
